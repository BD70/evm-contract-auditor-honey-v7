  "function_overrides": {
    "initialize(string,string,uint256,uint256,uint256,uint256,uint256,uint256,uint256,address,address)": {
      "mutability": "nonpayable",
      "state_writes": ["currentPhase <- Collecting", "collectionStartTime", "collectionEndTime", "interestStartTime", "termDuration", "fixedAPY", "minDeposit", "maxCapacity", "poolManager", "active <- true", "_initialized <- true"],
      "guards": ["not_already_initialized"],
      "branches": ["clone-pattern initializer with _initialized guard"]
    },
    "deposit(uint256,address)": {
      "mutability": "nonpayable",
      "state_reads": ["currentPhase", "collectionStartTime", "collectionEndTime", "maxCapacity", "totalPrincipal", "_depositInfos[receiver]", "_allocatedCap[receiver]", "whitelistEnabled", "_whitelist[receiver]"],
      "state_writes": ["_depositInfos[receiver].shares", "_depositInfos[receiver].principal", "totalPrincipal"],
      "guards": ["nonReentrant", "whenNotPaused", "onlyActive", "onlyPhase(Collecting)", "capacity_check", "whitelist_check"],
      "external_calls": ["asset().transferFrom(msg.sender, address(this), assets)"],
      "events": ["Deposit"]
    },
    "withdraw(uint256,address,address)": {
      "mutability": "nonpayable",
      "state_reads": ["currentPhase", "withdrawalStartTime", "_depositInfos[owner]", "_userClaimedInterest[owner]", "totalPrincipal"],
      "state_writes": ["_depositInfos[owner].principal", "_depositInfos[owner].shares", "totalPrincipal", "_userClaimedInterest[owner]", "totalClaimedInterest"],
      "guards": ["nonReentrant", "whenNotPaused", "phase_matured_or_defaulted", "withdrawal_time_check"],
      "external_calls": ["_burn(owner, shares)", "asset().safeTransfer(receiver, assets)", "_claimRemainingInterest(owner)"],
      "events": ["Withdraw"],
      "branches": ["VULNERABILITY: No require(msg.sender == owner) and no _spendAllowance check. Any caller can specify arbitrary owner and receiver."]
    },
    "redeem(uint256,address,address)": {
      "mutability": "nonpayable",
      "state_reads": ["currentPhase", "withdrawalStartTime", "_depositInfos[owner]", "_userClaimedInterest[owner]", "totalPrincipal"],
      "state_writes": ["_depositInfos[owner].principal", "_depositInfos[owner].shares", "totalPrincipal", "_userClaimedInterest[owner]", "totalClaimedInterest"],
      "guards": ["nonReentrant", "whenNotPaused", "phase_matured_or_defaulted", "withdrawal_time_check"],
      "external_calls": ["_burn(owner, shares)", "asset().safeTransfer(receiver, assets)", "_claimRemainingInterest(owner)"],
      "events": ["Withdraw"],
      "branches": ["VULNERABILITY: Same as withdraw — no caller authorization check before burning owner's shares"]
    },
    "claimInterest()": {
      "mutability": "nonpayable",
      "state_reads": ["currentPhase", "_depositInfos[msg.sender]", "interestPaymentDates", "fixedAPY"],
      "state_writes": ["_depositInfos[msg.sender].lastClaimMonth", "_userClaimedInterest[msg.sender]", "totalClaimedInterest", "totalInterestPaid"],
      "guards": ["nonReentrant", "whenNotPaused", "not_collecting_phase", "has_shares", "has_claimable"],
      "external_calls": ["asset().safeTransfer(msg.sender, interestAmount)"],
      "events": ["InterestClaimed"]
    }
  },
