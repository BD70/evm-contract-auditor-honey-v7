# Admin panel credentials (HTTP Basic Auth)
PANEL_USER=admin
PANEL_PASS=changeme

# Path to the parent repo root that contains runner/, rules/, evm_audit/, etc.
# Defaults to the directory containing the panel/ folder.
# REPO_ROOT=/absolute/path/to/evm-contract-auditor

# Override STATE_DIR observed by the panel. Defaults to value found in
# the runner .env, or `<REPO_ROOT>/runner-state`.
# STATE_DIR_OVERRIDE=

# Path to the runner .env file the panel reads/writes. Defaults to <REPO_ROOT>/.env
# RUNNER_ENV_FILE=

# Where the panel SQLite findings DB lives. Defaults to panel/data/findings.db
# PANEL_DB_PATH=
