{
  "name": "xocolatl_ladao",
  "description": "Profile for Xocolatl (LaDAO) DeFi protocol on Base - stablecoin lending with multi-reserve architecture",
  "selectors": [
    {"selector": "0x1a2b3c4d", "signature": "liquidateUser(address,address)"},
    {"selector": "0xc4d66de8", "signature": "initialize(address,address)"},
    {"selector": "0xf2fde38b", "signature": "transferOwnership(address)"},
    {"selector": "0x715018a6", "signature": "renounceOwnership()"},
    {"selector": "0x3659cfe6", "signature": "upgradeTo(address)"},
    {"selector": "0x4f1ef286", "signature": "upgradeToAndCall(address,bytes)"},
    {"selector": "0x8da5cb5b", "signature": "owner()"},
    {"selector": "0x52d1902d", "signature": "proxiableUUID()"}
  ],
  "protocol_components": {
    "AccountLiquidator": {
      "role": "liquidation_engine",
      "accepts_external_contract_parameters": true,
      "critical_parameters": ["houseOfReserve"],
      "notes": "The houseOfReserve parameter is accepted from calldata without on-chain validation against a registry"
    },
    "HouseOfReserve": {
      "role": "collateral_vault",
      "interface_methods": ["reserveAsset()", "backedAsset()", "reserveTokenID()", "backedTokenID()", "getLatestPrice()", "maxLTVFactor()", "liquidationFactor()"]
    },
    "HouseOfCoin": {
      "role": "debt_engine",
      "interface_methods": ["computeUserHealthRatio(address,address)", "getLiqParams()", "backedAsset()"]
    },
    "AssetsAccountant": {
      "role": "accounting_ledger",
      "interface_methods": ["balanceOf(address,uint256)", "safeTransferFrom(address,address,uint256,uint256,bytes)", "burn(address,uint256,uint256)"]
    }
  },
  "storage_anchors": [
    {"slot_name": "assetsAccountant", "semantic_role": "accounting_contract", "expected_type": "address"},
    {"slot_name": "houseOfCoin", "semantic_role": "debt_engine", "expected_type": "address"},
    {"slot_name": "backedAsset", "semantic_role": "stablecoin_token", "expected_type": "address"}
  ],
  "known_vulnerabilities": [],
  "function_overrides": {
    "liquidateUser(address,address)": {
      "mutability": "nonpayable",
      "state_reads": ["assetsAccountant", "houseOfCoin", "backedAsset"],
      "external_calls_to_calldata_parameters": ["houseOfReserve"],
      "events": ["MarginCall", "Liquidation"]
    }
  }
}
