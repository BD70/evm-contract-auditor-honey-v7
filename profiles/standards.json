{
  "name": "standards",
  "selectors": [
    {"selector": "0x18160ddd", "signature": "totalSupply()"},
    {"selector": "0x70a08231", "signature": "balanceOf(address)"},
    {"selector": "0xa9059cbb", "signature": "transfer(address,uint256)"},
    {"selector": "0x095ea7b3", "signature": "approve(address,uint256)"},
    {"selector": "0x23b872dd", "signature": "transferFrom(address,address,uint256)"},
    {"selector": "0xdd62ed3e", "signature": "allowance(address,address)"},
    {"selector": "0x06fdde03", "signature": "name()"},
    {"selector": "0x95d89b41", "signature": "symbol()"},
    {"selector": "0x313ce567", "signature": "decimals()"},
    {"selector": "0xd505accf", "signature": "permit(address,address,uint256,uint256,uint8,bytes32,bytes32)"},
    {"selector": "0x3644e515", "signature": "DOMAIN_SEPARATOR()"},
    {"selector": "0x7ecebe00", "signature": "nonces(address)"},
    {"selector": "0x30adf81f", "signature": "PERMIT_TYPEHASH()"},
    {"selector": "0x3659cfe6", "signature": "upgradeTo(address)"},
    {"selector": "0x4f1ef286", "signature": "upgradeToAndCall(address,bytes)"},
    {"selector": "0x5c60da1b", "signature": "implementation()"},
    {"selector": "0xf851a440", "signature": "admin()"},
    {"selector": "0x8f283970", "signature": "changeAdmin(address)"}
  ],
  "expected_permissionless": [
    "transfer(address,uint256)",
    "transferFrom(address,address,uint256)",
    "approve(address,uint256)",
    "permit(address,address,uint256,uint256,uint8,bytes32,bytes32)"
  ],
  "function_overrides": {
    "transfer(address,uint256)": {
      "mutability": "nonpayable",
      "state_reads": ["balanceOf[msg.sender]", "balanceOf[to]"],
      "state_writes": ["balanceOf[msg.sender] <- balanceOf[msg.sender] - value", "balanceOf[to] <- balanceOf[to] + value"],
      "events": ["Transfer"]
    },
    "transferFrom(address,address,uint256)": {
      "mutability": "nonpayable",
      "state_reads": ["balanceOf[from]", "balanceOf[to]", "allowance[from][msg.sender]"],
      "state_writes": ["allowance[from][msg.sender] <- allowance[from][msg.sender] - value", "balanceOf[from] <- balanceOf[from] - value", "balanceOf[to] <- balanceOf[to] + value"],
      "events": ["Transfer"]
    },
    "approve(address,uint256)": {
      "mutability": "nonpayable",
      "state_reads": [],
      "state_writes": ["allowance[msg.sender][spender] <- value"],
      "events": ["Approval"]
    },
    "permit(address,address,uint256,uint256,uint8,bytes32,bytes32)": {
      "mutability": "nonpayable",
      "state_reads": ["DOMAIN_SEPARATOR", "nonces[owner]"],
      "state_writes": ["nonces[owner] <- nonces[owner] + 1", "allowance[owner][spender] <- value"],
      "guards": ["deadline_not_expired", "valid_eip712_signature"],
      "events": ["Approval"]
    }
  }
}
