# ── Required ─────────────────────────────────────────────────────────────────
RPC_HTTP_URL=http://127.0.0.1:8545

# ── Optional RPC ─────────────────────────────────────────────────────────────
# RPC_WS_URL=ws://127.0.0.1:8545

# ── Block scanning ────────────────────────────────────────────────────────────
# START_BLOCK=0
# CONFIRMATIONS=2

# ── Detector rules ────────────────────────────────────────────────────────────
RULES_PATH=rules/core

# ── Python auditor ────────────────────────────────────────────────────────────
# PYTHON_BIN=python3
# AUDITOR_CMD=-m evm_audit
# ANALYSIS_TIMEOUT_MS=60000
# STEP_BUDGET_MS=120000      # soft per-audit pipeline budget; degrades gracefully

# ── Concurrency ───────────────────────────────────────────────────────────────
# MAX_AUDIT_WORKERS=4
# MAX_BLOCK_FETCH_CONCURRENCY=2
# MAX_WEBHOOK_CONCURRENCY=4

# ── Webhook (optional) ────────────────────────────────────────────────────────
# WEBHOOK_URL=https://your-service.example.com/evm-audit-hook
# WEBHOOK_AUTH_HEADER=Authorization:Bearer <token>
# WEBHOOK_MAX_ATTEMPTS=3

# ── State / artifacts ─────────────────────────────────────────────────────────
# STATE_DIR=runner-state

# ── Logging / UI ─────────────────────────────────────────────────────────────
# LOG_LEVEL=info
# UI_MODE=auto

# ── Startup health check ──────────────────────────────────────────────────────
#
# HEALTH_STRICT=true means the runner exits if any enabled probe fails.
# Set to false to start in degraded mode without dying.
#
# HEALTH_STRICT=true
#
# HTTP endpoints for liveness/readiness (Kubernetes / Docker health checks):
# HEALTH_PORT=9090
#
# ── Per-probe switches ────────────────────────────────────────────────────────
# Probe             Default  What it checks
# ─────────────────────────────────────────────────────────────────────────────
# HEALTH_PROBE_RPC         true   eth_blockNumber — verifies RPC is reachable
# HEALTH_PROBE_TRACE_API   false  debug_traceBlockByNumber — needs archive node
#                                 or premium provider plan. Enables internal
#                                 factory deployment detection. Leave false on
#                                 standard/free RPC tiers.
# HEALTH_PROBE_PYTHON      true   python3 -m evm_audit --version
# HEALTH_PROBE_RULES_DIR   true   rules path exists and has .json files
# HEALTH_PROBE_STATE_DIR   true   state dir is writable

# Uncomment to enable trace API probe (archive node / premium plan only):
# HEALTH_PROBE_TRACE_API=true

# Uncomment to disable any probe you don't need:
# HEALTH_PROBE_RPC=false
# HEALTH_PROBE_PYTHON=false
# HEALTH_PROBE_RULES_DIR=false
# HEALTH_PROBE_STATE_DIR=false
