# ═══════════════════════════════════════════════════
# EVM Contract Auditor - Environment Configuration
# ═══════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ──── RPC Endpoints ────
# Your Ethereum (or EVM chain) RPC endpoints
# Get one free at: Alchemy, Infura, NodeReal, QuickNode, etc.
RPC_HTTP_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY
RPC_WS_URL=wss://eth-mainnet.g.alchemy.com/ws/v2/YOUR_API_KEY

# ──── Block Scanner Settings ────
CONFIRMATIONS=2
START_BLOCK=0
POLL_INTERVAL_MS=3000
MAX_REORG_DEPTH=32

# ──── Paths ────
RULES_PATH=rules/core
STATE_DIR=runner-state
PYTHON_BIN=python3
AUDITOR_CMD=-m evm_audit

# ──── Concurrency & Limits ────
MAX_BLOCK_FETCH_CONCURRENCY=2
MAX_AUDIT_WORKERS=4
MAX_WEBHOOK_CONCURRENCY=4
ANALYSIS_TIMEOUT_MS=60000
MAX_HISTORY=128
MAX_ARTIFACT_INLINE_BYTES=32768
MAX_RESULT_CACHE_ENTRIES=5000
MAX_DELIVERED_EVENT_ENTRIES=20000
MAX_PENDING_WEBHOOK_ENTRIES=1000

# ──── Webhook (optional) ────
# URL to POST audit results to (leave empty to disable)
WEBHOOK_URL=
WEBHOOK_AUTH_HEADER=
WEBHOOK_MAX_ATTEMPTS=3

# ──── Retry & Resilience ────
RPC_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_MS=250

# ──── Logging & UI ────
LOG_LEVEL=info
UI_MODE=auto
HEALTH_PROBE_TRACE_API=false

# ──── LLM Integration (optional) ────
# For AI-powered analysis. Works with OpenAI-compatible APIs.
# Local example (Ollama): http://localhost:11434/v1
# OpenAI: https://api.openai.com/v1
EVM_LLM_BASE_URL=http://localhost:11434/v1
EVM_LLM_MODEL=qwen2.5-coder:14b
EVM_LLM_API_KEY=YOUR_LLM_API_KEY
EVM_LLM_TIMEOUT=30
