RPC_HTTP_URL=http://127.0.0.1:8545
RPC_WS_URL=ws://127.0.0.1:8545
CONFIRMATIONS=2
START_BLOCK=0
RULES_PATH=rules/core
PYTHON_BIN=python3
AUDITOR_CMD=-m evm_audit
MAX_BLOCK_FETCH_CONCURRENCY=2
MAX_AUDIT_WORKERS=4
MAX_WEBHOOK_CONCURRENCY=4
ANALYSIS_TIMEOUT_MS=60000
WEBHOOK_URL=
WEBHOOK_AUTH_HEADER=
STATE_DIR=runner-state
LOG_LEVEL=info
POLL_INTERVAL_MS=3000
MAX_REORG_DEPTH=32
MAX_HISTORY=128
MAX_ARTIFACT_INLINE_BYTES=32768
WEBHOOK_MAX_ATTEMPTS=3
RPC_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_MS=250
MAX_RESULT_CACHE_ENTRIES=5000
MAX_DELIVERED_EVENT_ENTRIES=20000
MAX_PENDING_WEBHOOK_ENTRIES=1000
UI_MODE=auto


# LLM SHIT

EVM_LLM_BASE_URL=http://localhost:11434/v1
EVM_LLM_MODEL=qwen2.5-coder:14b
EVM_LLM_API_KEY=local
EVM_LLM_TIMEOUT=30


RESCUE_ESCROW_ADDR=0x...
RESCUER_PRIVATE_KEY=0x...
RESCUE_AUTH_TOKEN=...long-random...
RESCUE_BROADCAST_ENABLED=true
TG_BOT_TOKEN=...
TG_CHAT_ID=...
TG_ALLOWED_CHAT_IDS=...

# ---- rescue-prove v5 knobs (all optional; sensible defaults shown) ----
#
# v5 invariant: the rescue is ALWAYS sent from RESCUER_PRIVATE_KEY (the
# attacker-side EOA). Owner-only findings are not auto-rescuable by design
# — if only the contract owner can drain, an attacker can't, so there is
# nothing for the rescue pipeline to frontrun. The previous v2-v4 knobs
# RESCUE_IMPERSONATE_OWNER, RESCUE_OWNER_PRIVATE_KEY, and
# RESCUE_SAFE_TX_SERVICE_URL were removed in v5.

# v3-A: approval-surface drain mode.
#   "off"        — never scan
#   "scan-only"  — scan and surface victims in UI, but never auto-build a
#                  drain plan (default; safest)
#   "auto"       — build a drain plan that includes ONLY victims listed in
#                  RESCUE_APPROVAL_CONSENT_VICTIMS below (per-victim consent)
RESCUE_APPROVAL_CONSENT_MODE=scan-only
RESCUE_APPROVAL_CONSENT_VICTIMS=0xvictim1,0xvictim2
# Log lookback window for Approval events. Larger = slower scan but catches
# older approvals.
RESCUE_APPROVAL_LOOKBACK=200000
RESCUE_APPROVAL_MAX_VICTIMS=50

# v3-FL: flash-loan stub. Default ON. The stub grants the attacker capital
# via anvil_setBalance on the fork to prove drainability for economic.*
# exploits; live broadcast of these PoEs is REFUSED until you deploy a
# flash-loan receiver contract.
RESCUE_FLASHLOAN_ENABLED=true
RESCUE_FLASHLOAN_GRANT_ETH=100

# v4: real flash-loan receiver contract(s). Format: "chainId:0xaddr,chainId:0xaddr".
# When set for a chain, the broadcaster routes requires_flashloan_helper PoEs
# through receiver.executeRescue(...) instead of refusing live mode. Deploy
# contracts/rescue/FlashLoanRescue.sol per-chain via `forge create` first.
RESCUE_FLASHLOAN_RECEIVER=

# v4: bespoke proxy storage layout support. Comma-separated list of slots
# (hex 0x... or decimal) to probe for owner addresses when the standard
# ERC-1967 / OZ Initializable / numeric slot scan misses. Diagnostic only —
# surfaces probable owner in PoE notes.
RESCUE_EXTRA_ADMIN_SLOTS=